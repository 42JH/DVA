pipeline {
    agent { label 'msa-builder' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        disableRestartFromStage()
        timestamps()
        timeout(time: 120, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '2'))
    }

    stages {
        stage('Checkout') {
            steps {
                // Jenkins workspace only: prevent previous reports from being reused.
                deleteDir()
                script {
                    def source = checkout scm
                    env.SOURCE_BRANCH = source.GIT_BRANCH ?: ''
                    env.SOURCE_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    env.RELEASE_NAME = "${env.SOURCE_COMMIT}-${env.BUILD_NUMBER}"
                    env.DB_IMAGE = "docker.io/library/dva-liquibase:${env.RELEASE_NAME}"
                    env.RUN_MSA_CI = 'true'
                    env.MSA_BASE_COMMIT = source.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: ''
                    def backendBranch = env.SOURCE_BRANCH in ['origin/develop-backend', 'develop-backend']
                    env.DELIVER_APPS = (backendBranch && !env.CHANGE_ID).toString()
                    if (env.DELIVER_APPS == 'true') {
                        sh 'test "$(git rev-parse origin/develop-backend)" = "$SOURCE_COMMIT"'
                    }
                }
            }
        }

        stage('Check Environment and Scripts') {
            when { expression { env.RUN_MSA_CI == 'true' } }
            steps {
                sh '''
                    set -eu
                    test "$(uname -s)" = Linux
                    test "$(uname -m)" = x86_64
                    for tool in docker python3 bash ssh scp sha256sum realpath; do command -v "$tool"; done
                    docker version
                    python3 --version
                    for script in msa/deploy/*.sh msa/liquibase/*.sh; do bash -n "$script"; done
                    python3 -m unittest discover -s msa/deploy/tests -v
                '''
            }
        }

        stage('Verify Event Transport') {
            when { expression { env.RUN_MSA_CI == 'true' } }
            steps { sh 'python3 msa/shared/events/verify.py' }
        }

        stage('Select Build Scope') {
            when { expression { env.RUN_MSA_CI == 'true' } }
            steps {
                sh 'mkdir -p msa-release'
                script {
                    if (env.DELIVER_APPS == 'true') {
                        withCredentials([sshUserPrivateKey(credentialsId: 'dva-msa-ssh', keyFileVariable: 'MSA_SSH_KEY')]) {
                            sh 'set +x; bash msa/deploy/read-app-state.sh "$MSA_SSH_KEY" > msa-release/cluster-state.json'
                        }
                    }
                    sh 'python3 msa/deploy/plan-apps.py'
                    env.HAS_DB_DELIVERY = (!readFile('msa-release/databases.txt').trim().isEmpty()).toString()
                    env.RUN_DB_CI = readFile('msa-release/database-ci.txt').trim()
                    env.HAS_APP_BUILD = (!readFile('msa-release/services.txt').trim().isEmpty()).toString()
                }
            }
        }

        stage('Verify Database') {
            when {
                expression {
                    env.RUN_MSA_CI == 'true' && env.RUN_DB_CI == 'true'
                }
            }
            steps { sh 'python3 msa/liquibase/verify.py' }
            post {
                always {
                    archiveArtifacts artifacts: 'msa/liquibase/verification.json,msa/liquibase/verification-logs/**', allowEmptyArchive: true
                }
            }
        }

        stage('Verify and Build Services') {
            when { expression { env.RUN_MSA_CI == 'true' } }
            steps {
                sh '''
                    set -eu

                    while IFS= read -r service; do
                        directory="msa/services/$service"
                        echo "BUILD: $service"
                        docker build \
                            --tag "docker.io/library/dva-$service:$RELEASE_NAME" \
                            "$directory"

                        bash msa/deploy/package-app.sh "$service"
                    done < msa-release/services.txt
                '''
            }
            post {
                success {
                    archiveArtifacts(
                        artifacts: "msa-release/apps/${env.RELEASE_NAME}/**",
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Package Database Image') {
            when {
                expression {
                    env.RUN_MSA_CI == 'true' && env.RUN_DB_CI == 'true'
                }
            }
            steps { sh 'bash msa/deploy/package.sh' }
            post {
                success {
                    archiveArtifacts artifacts: "msa-release/${env.RELEASE_NAME}/**", allowEmptyArchive: false
                }
            }
        }

        stage('Release Delivery') {
            when { expression { env.DELIVER_APPS == 'true' } }
            options {
                timeout(time: 90, unit: 'MINUTES')
                lock(resource: 'dva-msa-database-deploy')
            }
            stages {
                stage('Database Delivery') {
                    when { expression { env.HAS_DB_DELIVERY == 'true' } }
                    steps {
                        withCredentials([sshUserPrivateKey(credentialsId: 'dva-msa-ssh', keyFileVariable: 'MSA_SSH_KEY')]) {
                            sh 'set +x; bash msa/deploy/deliver-databases.sh "$MSA_SSH_KEY"'
                        }
                    }
                    post {
                        always { archiveArtifacts artifacts: 'msa-release/db-logs/**', allowEmptyArchive: true }
                    }
                }
                stage('Application Delivery') {
                    when {
                        expression {
                            env.RUN_MSA_CI == 'true' &&
                            env.DELIVER_APPS == 'true' && env.HAS_APP_BUILD == 'true'
                        }
                    }
                    options {
                        timeout(time: 45, unit: 'MINUTES')
                    }
                    steps {
                        withCredentials([
                            sshUserPrivateKey(
                                credentialsId: 'dva-msa-ssh',
                                keyFileVariable: 'MSA_SSH_KEY'
                            )
                        ]) {
                            sh '''
                                #!/bin/bash
                                set +x
                                set -euo pipefail

                                mkdir -p msa-release/app-logs
                                count=0

                                for package in msa-release/apps/"$RELEASE_NAME"/*; do
                                    [ -d "$package" ] || continue
                                    service=$(basename "$package")

                                    bash msa/deploy/upload-app.sh \
                                        "$package" "$MSA_SSH_KEY" \
                                        2>&1 | tee "msa-release/app-logs/$service.log"

                                    grep -Fx "DVA_APP_ROLLOUT_COMPLETE=$service" \
                                        "msa-release/app-logs/$service.log"

                                    count=$((count + 1))
                                done

                                if [ "$count" -eq 0 ]; then
                                    echo 'No application packages to deploy.' >&2
                                    exit 1
                                fi
                            '''.stripIndent().trim()
                        }
                    }
                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'msa-release/app-logs/**',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }
            }
        }
    }
    post {
        failure { echo 'Release failed. Application delivery does not run after a database failure. Inspect migration/rollout logs before retrying.' }
        aborted { echo 'Pipeline aborted. An already-started k3s Job may still be running; inspect it before retrying.' }
    }
}
