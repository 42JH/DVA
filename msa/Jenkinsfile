def verificationHistory() {
    def history = [:]
    def previous = currentBuild.previousBuild
    def scopes = ['database', 'operations', 'customer', 'consultation', 'order', 'events', 'deployment']
    while (previous != null && history.size() < scopes.size()) {
        def variables = previous.getBuildVariables()
        scopes.each { scope ->
            def stamp = variables["MSA_VERIFIED_${scope.toUpperCase()}"]
            if (!history.containsKey(scope) && stamp) {
                history[scope] = stamp
            }
        }
        previous = previous.previousBuild
    }
    return history
}

def recordVerification(String scope) {
    sh "python3 msa/.ci-source/msa/parity/ci_verification.py record ${scope}"
    env["MSA_VERIFIED_${scope.toUpperCase()}"] = readFile("msa-release/verified-${scope}.txt").trim()
}

pipeline {
    agent { label 'msa-builder' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        disableRestartFromStage()
        timestamps()
        timeout(time: 120, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '2'))
    }

    stages {
        stage('Checkout') {
            steps {
                // Jenkins workspace only: prevent previous reports from being reused.
                deleteDir()
                script {
                    def source = checkout scm
                    env.SOURCE_BRANCH = source.GIT_BRANCH ?: ''
                    env.SOURCE_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    env.RELEASE_NAME = "${env.SOURCE_COMMIT}-${env.BUILD_NUMBER}"
                    env.DB_IMAGE = "docker.io/library/dva-liquibase:${env.RELEASE_NAME}"
                    env.RUN_MSA_CI = 'true'
                    env.MSA_BASE_COMMIT = source.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: ''
                    sh 'mkdir -p msa-release'
                    def history = verificationHistory()
                    history.each { scope, stamp -> env["MSA_VERIFIED_${scope.toUpperCase()}"] = stamp }
                    writeFile file: 'msa-release/verification-history.json', text: groovy.json.JsonOutput.toJson(history)
                    def backendBranch = env.SOURCE_BRANCH in ['origin/develop-backend', 'develop-backend']
                    env.DELIVER_APPS = (backendBranch && !env.CHANGE_ID).toString()
                    if (env.DELIVER_APPS == 'true') {
                        sh 'test "$(git rev-parse origin/develop-backend)" = "$SOURCE_COMMIT"'
                    }
                }
            }
        }

        stage('Check Environment and Scripts') {
            when { expression { env.RUN_MSA_CI == 'true' } }
            steps {
                sh '''
                    set -eu
                    test "$(uname -s)" = Linux
                    test "$(uname -m)" = x86_64
                    for tool in docker node python3 git bash ssh scp sha256sum realpath; do command -v "$tool"; done
                    docker version
                    python3 --version
                    for script in msa/deploy/*.sh msa/liquibase/*.sh; do bash -n "$script"; done
                '''
            }
        }

        stage('Prepare CI Reference') {
            steps {
                sh 'python3 msa/parity/ci_workspace.py'
                script { env.MSA_CI_ORIGINAL_COMMIT = env.SOURCE_COMMIT }
            }
        }

        stage('Select Build Scope') {
            when { expression { env.RUN_MSA_CI == 'true' } }
            steps {
                sh 'mkdir -p msa-release'
                script {
                    if (env.DELIVER_APPS == 'true') {
                        withCredentials([sshUserPrivateKey(credentialsId: 'dva-msa-ssh', keyFileVariable: 'MSA_SSH_KEY')]) {
                            sh 'set +x; bash msa/deploy/read-app-state.sh "$MSA_SSH_KEY" > msa-release/cluster-state.json'
                        }
                    }
                    sh 'python3 msa/deploy/plan-apps.py'
                    env.HAS_DB_DELIVERY = (env.DELIVER_APPS == 'true' && !readFile('msa-release/databases.txt').trim().isEmpty()).toString()
                    env.RUN_DB_CI = readFile('msa-release/database-ci.txt').trim()
                    env.HAS_APP_BUILD = (!readFile('msa-release/services.txt').trim().isEmpty()).toString()
                    env.RUN_EVENT_CI = readFile('msa-release/event-ci.txt').trim()
                    env.RUN_DEPLOY_CI = readFile('msa-release/deployment-ci.txt').trim()
                }
            }
        }

        stage('Verify Deployment Scripts') {
            when { expression { env.RUN_DEPLOY_CI == 'true' } }
            steps {
                sh 'python3 -m unittest discover -s msa/deploy/tests -v'
                script { recordVerification('deployment') }
            }
        }

        stage('Verify Contracts') {
            steps {
                sh 'node --test msa/.ci-source/msa/parity/inventory.test.cjs msa/.ci-source/msa/parity/final-contract.test.cjs'
            }
        }

        stage('Verify Event Transport') {
            when { expression { env.RUN_EVENT_CI == 'true' } }
            steps {
                sh 'python3 msa/.ci-source/msa/shared/events/verify.py'
                script { recordVerification('events') }
            }
        }

        stage('Build CI Images') {
            when { expression { env.RUN_MSA_CI == 'true' } }
            steps {
                sh 'python3 msa/.ci-source/msa/parity/ci_images.py build'
                script { env.MSA_CI_IMAGES = "${env.WORKSPACE}/msa-release/ci-images.json" }
            }
        }

        stage('Verify Database') {
            when {
                expression {
                    env.RUN_MSA_CI == 'true' && env.RUN_DB_CI == 'true'
                }
            }
            steps {
                sh 'python3 msa/.ci-source/msa/liquibase/verify.py'
                script { recordVerification('database') }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'msa/liquibase/verification.json,msa/liquibase/verification-logs/**', allowEmptyArchive: true
                }
            }
        }

        stage('Reuse Unchanged Database Verification') {
            when { expression { env.RUN_DB_CI == 'false' && env.HAS_DB_DELIVERY == 'true' } }
            steps {
                sh 'python3 msa/.ci-source/msa/parity/ci_verification.py reuse-database'
                script { recordVerification('database') }
            }
            post {
                always { archiveArtifacts artifacts: 'msa/liquibase/verification.json', allowEmptyArchive: false }
            }
        }

        stage('Verify Operations Parity') {
            when {
                expression {
                    env.RUN_MSA_CI == 'true' && readFile('msa-release/parity-suites.txt').tokenize().contains('operations')
                }
            }
            steps {
                sh 'python3 msa/.ci-source/msa/parity/verify-operations.py'
                script { recordVerification('operations') }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'msa/liquibase/verification-logs/operations/**', allowEmptyArchive: true
                }
            }
        }

        stage('Verify Customer Parity') {
            when {
                expression {
                    env.RUN_MSA_CI == 'true' && readFile('msa-release/parity-suites.txt').tokenize().contains('customer')
                }
            }
            steps {
                sh 'python3 msa/.ci-source/msa/parity/verify-customer.py'
                script { recordVerification('customer') }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'msa/liquibase/verification-logs/customer/**', allowEmptyArchive: true
                }
            }
        }

        stage('Verify Consultation Parity') {
            when {
                expression {
                    env.RUN_MSA_CI == 'true' && readFile('msa-release/parity-suites.txt').tokenize().contains('consultation')
                }
            }
            steps {
                sh 'python3 msa/.ci-source/msa/parity/verify-consultation.py'
                script { recordVerification('consultation') }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'msa/liquibase/verification-logs/consultation/**', allowEmptyArchive: true
                }
            }
        }

        stage('Verify Order Parity') {
            when {
                expression {
                    env.RUN_MSA_CI == 'true' && readFile('msa-release/parity-suites.txt').tokenize().contains('order')
                }
            }
            steps {
                sh 'python3 msa/.ci-source/msa/parity/verify-order.py'
                script { recordVerification('order') }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'msa/liquibase/verification-logs/order/**', allowEmptyArchive: true
                }
            }
        }

        stage('Verify and Build Services') {
            when { expression { env.RUN_MSA_CI == 'true' && env.DELIVER_APPS == 'true' && env.HAS_APP_BUILD == 'true' } }
            steps {
                sh '''
                    set -eu

                    while IFS= read -r service; do
                        image=$(python3 msa/.ci-source/msa/parity/ci_images.py "$service")
                        test -n "$image"
                        docker tag "$image" "docker.io/library/dva-$service:$RELEASE_NAME"
                        bash msa/deploy/package-app.sh "$service"
                    done < msa-release/services.txt
                '''
            }
            post {
                success {
                    archiveArtifacts(
                        artifacts: "msa-release/apps/${env.RELEASE_NAME}/**",
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Package Database Image') {
            when {
                expression {
                    env.RUN_MSA_CI == 'true' && env.HAS_DB_DELIVERY == 'true'
                }
            }
            steps { sh 'bash msa/deploy/package.sh' }
            post {
                success {
                    archiveArtifacts artifacts: "msa-release/${env.RELEASE_NAME}/**", allowEmptyArchive: false
                }
            }
        }

        stage('Release Delivery') {
            when { expression { env.DELIVER_APPS == 'true' } }
            options {
                timeout(time: 90, unit: 'MINUTES')
                lock(resource: 'dva-msa-database-deploy')
            }
            stages {
                stage('Stage Application Images') {
                    when { expression { env.HAS_APP_BUILD == 'true' } }
                    steps {
                        withCredentials([sshUserPrivateKey(credentialsId: 'dva-msa-ssh', keyFileVariable: 'MSA_SSH_KEY')]) {
                            sh '''
                                set +x
                                set -eu
                                mkdir -p msa-release/app-logs
                                while IFS= read -r service; do
                                    if ! bash msa/deploy/upload-app.sh "msa-release/apps/$RELEASE_NAME/$service" "$MSA_SSH_KEY" prepare > "msa-release/app-logs/$service-prepare.log" 2>&1; then
                                        cat "msa-release/app-logs/$service-prepare.log" >&2
                                        exit 1
                                    fi
                                    cat "msa-release/app-logs/$service-prepare.log"
                                    grep -Fx "DVA_APP_IMAGE_PREPARED=$service" "msa-release/app-logs/$service-prepare.log"
                                done < msa-release/services.txt
                            '''
                        }
                    }
                    post { always { archiveArtifacts artifacts: 'msa-release/app-logs/**', allowEmptyArchive: true } }
                }
                stage('Database Delivery') {
                    when { expression { env.HAS_DB_DELIVERY == 'true' } }
                    steps {
                        withCredentials([sshUserPrivateKey(credentialsId: 'dva-msa-ssh', keyFileVariable: 'MSA_SSH_KEY')]) {
                            sh 'set +x; bash msa/deploy/deliver-databases.sh "$MSA_SSH_KEY"'
                        }
                    }
                    post {
                        always { archiveArtifacts artifacts: 'msa-release/db-logs/**', allowEmptyArchive: true }
                    }
                }
                stage('Application Delivery') {
                    when {
                        expression {
                            env.RUN_MSA_CI == 'true' &&
                            env.DELIVER_APPS == 'true' && env.HAS_APP_BUILD == 'true'
                        }
                    }
                    options {
                        timeout(time: 45, unit: 'MINUTES')
                    }
                    steps {
                        withCredentials([
                            sshUserPrivateKey(
                                credentialsId: 'dva-msa-ssh',
                                keyFileVariable: 'MSA_SSH_KEY'
                            )
                        ]) {
                            sh '''
                                #!/bin/bash
                                set +x
                                set -euo pipefail

                                mkdir -p msa-release/app-logs
                                count=0

                                while IFS= read -r service; do
                                    package="msa-release/apps/$RELEASE_NAME/$service"
                                    test -d "$package"

                                    bash msa/deploy/upload-app.sh \
                                        "$package" "$MSA_SSH_KEY" apply \
                                        2>&1 | tee "msa-release/app-logs/$service.log"

                                    grep -Fx "DVA_APP_ROLLOUT_COMPLETE=$service" \
                                        "msa-release/app-logs/$service.log"

                                    count=$((count + 1))
                                done < msa-release/services.txt

                                if [ "$count" -eq 0 ]; then
                                    echo 'No application packages to deploy.' >&2
                                    exit 1
                                fi
                            '''.stripIndent().trim()
                        }
                    }
                    post {
                        always {
                            archiveArtifacts(
                                artifacts: 'msa-release/app-logs/**',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'msa-release/ci-images.json,msa-release/reference.json,msa-release/verification-*.json,msa-release/verified-*.txt', allowEmptyArchive: true
            script {
                if (fileExists('msa/parity/ci_images.py')) {
                    sh 'python3 msa/parity/ci_images.py cleanup'
                }
            }
        }
        failure { echo 'Release failed. Application delivery does not run after a database failure. Inspect migration/rollout logs before retrying.' }
        aborted { echo 'Pipeline aborted. An already-started k3s Job may still be running; inspect it before retrying.' }
    }
}
