{
  "uid": "dva-msa",
  "title": "DVA MSA 운영 상태",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-30m", "to": "now"},
  "tags": ["dva", "msa"],
  "templating": {"list":[{"type":"custom","name":"service","query":"operations,customer,consultation,delivery,order","includeAll":true,"allValue":".*","multi":true,"current":{"text":"All","value":"$__all"}},{"type":"textbox","name":"trace","query":"","current":{"text":"","value":""},"label":"requestId 또는 eventId"}]},
  "panels": [
    {"id":1,"title":"수집 가능한 Pod","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":0,"y":0},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (service) (last_over_time(up{job=\"dva-msa-app\"}[75s]))","legendFormat":"__auto"}]},
    {"id":2,"title":"DB 연결","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":12,"y":0},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"min by (service) (dva_database_up{job=\"dva-msa-app\"})","legendFormat":"__auto"}]},
    {"id":3,"title":"CPU 사용량","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":0,"y":7},"fieldConfig":{"defaults":{"unit":"cores"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (service, pod) (rate(container_cpu_usage_seconds_total{job=\"dva-msa-kubelet\"}[5m]))","legendFormat":"__auto"}]},
    {"id":4,"title":"메모리 working set","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":12,"y":7},"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (service, pod) (container_memory_working_set_bytes{job=\"dva-msa-kubelet\"})","legendFormat":"__auto"}]},
    {"id":5,"title":"Pod별 요청량","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":0,"y":14},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (service, pod) (rate(dva_http_requests_total{job=\"dva-msa-app\"}[5m]))","legendFormat":"__auto"}]},
    {"id":6,"title":"서비스별 p95 응답 시간","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":12,"y":14},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (service, le) (rate(dva_http_request_duration_seconds_bucket{job=\"dva-msa-app\"}[5m])))","legendFormat":"__auto"}]},
    {"id":7,"title":"5xx 비율","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":0,"y":21},"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]},"targets":[{"refId":"A","expr":"100 * (sum by (service) (rate(dva_http_requests_total{job=\"dva-msa-app\",status=~\"5..\"}[5m])) or 0 * sum by (service) (rate(dva_http_requests_total{job=\"dva-msa-app\"}[5m]))) / (sum by (service) (rate(dva_http_requests_total{job=\"dva-msa-app\"}[5m])) > 0)","legendFormat":"__auto"}]},
    {"id":8,"title":"DB 연결 대기","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":12,"y":21},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (service) (dva_database_pool_waiting_requests{job=\"dva-msa-app\"})","legendFormat":"__auto"}]},
    {"id":9,"title":"DB pool 사용·유휴","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":0,"y":28},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (service, state) (dva_database_pool_connections{job=\"dva-msa-app\"})","legendFormat":"__auto"}]},
    {"id":10,"title":"미전달·재시도 이벤트","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":12,"y":28},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"max by (service) (dva_outbox_pending{job=\"dva-msa-app\"})","legendFormat":"{{service}} pending"},{"refId":"B","expr":"max by (service) (dva_outbox_retrying{job=\"dva-msa-app\"})","legendFormat":"{{service}} retrying"}]},
    {"id":11,"title":"가장 오래된 미전달 이벤트","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":0,"y":35},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"refId":"A","expr":"max by (service) (dva_outbox_oldest_pending_seconds{job=\"dva-msa-app\"})","legendFormat":"__auto"}]},
    {"id":12,"title":"탐지된 장애","type":"timeseries","datasource":{"type":"prometheus","uid":"msa-prometheus"},"gridPos":{"h":7,"w":12,"x":12,"y":35},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"ALERTS{alertname=~\"DvaMsa.*\",alertstate=\"firing\"}","legendFormat":"__auto"}]},
    {"id":20,"title":"요청·이벤트 로그","type":"logs","datasource":{"type":"loki","uid":"msa-loki"},"gridPos":{"h":12,"w":24,"x":0,"y":42},"targets":[{"refId":"A","expr":"{environment=\"k3s\",service=~\"${service:regex}\"} |= ${trace:doublequote}"}]}
  ]
}
