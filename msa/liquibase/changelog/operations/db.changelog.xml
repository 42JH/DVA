  </changeSet>
  <changeSet id="010-order-audit" author="dva" dbms="postgresql" runInTransaction="true">
    <sqlFile path="010-order-audit.sql" relativeToChangelogFile="true" encoding="UTF-8" splitStatements="false" stripComments="false"/>
  </changeSet>
</databaseChangeLog>
