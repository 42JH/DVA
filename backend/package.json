{
  "name": "dva-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Dva monolithic NestJS backend starter",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\" \"scripts/*.cjs\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\" \"scripts/*.cjs\" \"*.json\" \"*.mjs\"",
    "test": "npm run build && node --test test/config.test.cjs test/http-foundation.test.cjs test/auth.test.cjs",
    "test:integration": "node --test --test-concurrency=1 test/database.integration.test.cjs test/webhook.integration.test.cjs test/auth.integration.test.cjs && node --test test/organizations.integration.test.cjs",
    "check": "npm run lint && npm run format:check && npm test",
    "check:docker": "node scripts/check.cjs",
    "bootstrap:admin": "npm run build && node scripts/bootstrap-admin.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "express": {
      "body-parser": "2.4.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.13.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.20.0"
  }
}
