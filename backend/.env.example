# Copy to .env.development for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dva_dev
DB_PASSWORD=replace-with-your-local-db-password
DB_NAME=monolith_dev
AI_AGENT_URL=http://127.0.0.1:8000
# 고객 확인·등록·상세·수정 전용 32자 이상 무작위 ASCII 토큰. 비어 있으면 AI 고객 호출은 503.
AI_BUSINESS_TOKEN=
# AI 담당 서버와 공유할 32자 이상 무작위 토큰. 비어 있으면 페르소나 연동만 비활성.
AI_PERSONA_TOKEN=
# FAQ 변경 알림 전용 32자 이상 토큰. 비어 있으면 알림 대기를 보존하고 전송만 비활성.
AI_FAQ_TOKEN=
# AI 통화 분석·이벤트 수집 전용 32자 이상 토큰. 비어 있으면 ANL-01·EVT-01은 503.
AI_INSIGHTS_TOKEN=
# Exact frontend origins, comma-separated; required for all admin mutation requests.
# Local example: http://localhost:5173. Include the same-origin HTTPS frontend in production.
CORS_ORIGINS=
SWAGGER_ENABLED=true
# Leave empty until testing the PBX webhook; configure a random token of at least 32 bytes.
PBX_WEBHOOK_TOKEN=

# Keep the key empty until Dver submission is configured. Never commit the real key.
DVER_API_URL=https://public-n8n.dvercorp.co.kr:47514/webhook/parcel
DVER_API_KEY=

# Real orders, test-only Toss approval. Enable after configuring the HTTPS origin above.
ORDER_PAYMENTS_ENABLED=false
PAYMENT_PUBLIC_URL=
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=
PAYMENT_MATTERMOST_WEBHOOK_URL=

# Private recording bucket. Empty bucket disables the worker; receipts remain durable.
AWS_REGION=ap-northeast-2
S3_RECORDINGS_BUCKET=
# Use an instance role, or inject these via deployment secrets. Never commit credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
RECORDING_ALLOWED_HOSTS=dvercorp-aicc-connect-dev-recordings.s3.ap-northeast-2.amazonaws.com
# Conservative starting window; calibrate against OpenAI/PBX event timestamps.
RECORDING_MATCH_WINDOW_SECONDS=30
