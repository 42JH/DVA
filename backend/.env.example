# Copy to .env.development for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
# Direct Node: 0. Development Compose injects 1; production's host + container Nginx injects 2.
# Use forwarded IPs only when backend ports are private and the edge overwrites X-Forwarded-For.
AUTH_PROXY_HOPS=0
# Backend only: 32 random bytes encoded as 64 hexadecimal characters. Required in production.
# Development/test without a key use a process-local temporary key; never share this key with AI/FE.
SECURITY_LOG_HMAC_KEY=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dva_dev
DB_PASSWORD=replace-with-your-local-db-password
DB_NAME=monolith_dev
AI_AGENT_URL=http://127.0.0.1:8000
# 고객 확인·등록·상세·수정 전용 32자 이상 무작위 ASCII 토큰. 비어 있으면 AI 고객 호출은 503.
AI_BUSINESS_TOKEN=
# AI 담당 서버와 공유할 32자 이상 무작위 토큰. 비어 있으면 페르소나 연동만 비활성.
AI_PERSONA_TOKEN=
# Optional administrator scenario-test relay. Use the trial service's 64-digit hex token.
PERSONA_CHECK_URL=
PERSONA_CHECK_TOKEN=
# FAQ 변경 알림 전용 32자 이상 토큰. 비어 있으면 알림 대기를 보존하고 전송만 비활성.
AI_FAQ_TOKEN=
# AI 통화 분석·이벤트 수집 전용 32자 이상 토큰. 비어 있으면 ANL-01·EVT-01은 503.
AI_INSIGHTS_TOKEN=
# 통화 불만 판정(후처리) 전용 OpenAI 키 — 실시간 상담 키와 따로. 비어 있으면 판정 워커만 꺼짐. 실제 키는 커밋하지 않는다.
CALL_ANALYSIS_OPENAI_API_KEY=
# 동시에 판정할 통화 수 1~4 (통화 하나가 모델을 3번 동시에 부름)
CALL_ANALYSIS_CONCURRENCY=2
# Exact frontend origins, comma-separated; required for all admin mutation requests.
# Local example: http://localhost:5173. Include the same-origin HTTPS frontend in production.
CORS_ORIGINS=
SWAGGER_ENABLED=false
# Leave empty until testing the PBX webhook; configure a random token of at least 32 bytes.
PBX_WEBHOOK_TOKEN=

# Set both values to enable Dver submission. Inject the endpoint and key at deployment.
DVER_API_URL=
DVER_API_KEY=

# Real orders, test-only Toss approval. Enable after configuring the HTTPS origin above.
ORDER_PAYMENTS_ENABLED=false
PAYMENT_PUBLIC_URL=
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=
# API 개별 연동 자동결제(빌링) 상점의 시크릿 키. 기존 결제창 키는 그대로 유지한다.
TOSS_BILLING_SECRET_KEY=
# 카드 결제키 암호화용 32바이트 난수의 64자리 hex. 최초 발급 후 보존·백업한다.
PAYMENT_CARD_ENCRYPTION_KEY=
PAYMENT_MATTERMOST_WEBHOOK_URL=

# Private recording bucket. Empty bucket disables the worker; receipts remain durable.
AWS_REGION=ap-northeast-2
S3_RECORDINGS_BUCKET=
# Use an instance role, or inject these via deployment secrets. Never commit credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Comma-separated source hostnames. An empty list blocks new source downloads.
RECORDING_ALLOWED_HOSTS=
# Conservative starting window; calibrate against OpenAI/PBX event timestamps.
RECORDING_MATCH_WINDOW_SECONDS=30
