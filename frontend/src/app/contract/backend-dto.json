{
  "source": "https://13.209.59.180/api/docs-json",
  "version": "0.1.0",
  "operations": {
    "POST /api/admin/orders": {
      "allOf": [
        {
          "$ref": "#/components/schemas/CreateManualOrderDto"
        }
      ],
      "oneOf": [
        {
          "required": ["customerSeq"]
        },
        {
          "required": ["customer"]
        }
      ]
    },
    "PATCH /api/orders/{id}": {
      "$ref": "#/components/schemas/UpdateOrderDto"
    },
    "PATCH /api/customers/{id}": {
      "$ref": "#/components/schemas/UpdateCustomerDto"
    },
    "POST /api/companies/{id}/members": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/CreateMemberDto"
        },
        {
          "$ref": "#/components/schemas/InlineMemberDto"
        },
        {
          "$ref": "#/components/schemas/CreateMembersDto"
        }
      ]
    },
    "POST /api/faqs": {
      "$ref": "#/components/schemas/CreateFaqsDto"
    },
    "PATCH /api/faqs/{id}": {
      "$ref": "#/components/schemas/UpdateFaqDto"
    }
  },
  "schemas": {
    "CreateManualOrderDto": {
      "type": "object",
      "properties": {
        "totalAmount": {
          "type": "object",
          "minimum": 1,
          "maximum": 2147483647,
          "nullable": true
        },
        "customerSeq": {
          "type": "number",
          "minimum": 1,
          "maximum": 2147483647
        },
        "customer": {
          "allOf": [
            {
              "$ref": "#/components/schemas/OrderCustomerDto"
            }
          ]
        },
        "paymentMethodType": {
          "type": "string",
          "enum": ["billing", "credit", "groupBilling"]
        },
        "pickupRequestedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "parcels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ParcelInputDto"
          }
        }
      },
      "required": ["parcels"]
    },
    "UpdateOrderDto": {
      "type": "object",
      "properties": {
        "totalAmount": {
          "type": "object",
          "minimum": 1,
          "maximum": 2147483647,
          "nullable": true
        },
        "paymentMethodType": {
          "type": "string",
          "enum": ["billing", "credit", "groupBilling"]
        },
        "pickupRequestedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "expectedVersion": {
          "type": "number",
          "minimum": 1,
          "maximum": 2147483647
        },
        "removeParcelSeqs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "minItems": 1
        },
        "parcels": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ParcelChangeDto"
          }
        }
      },
      "required": ["expectedVersion"]
    },
    "UpdateCustomerDto": {
      "type": "object",
      "properties": {
        "address": {
          "nullable": true,
          "type": "object",
          "allOf": [
            {
              "$ref": "#/components/schemas/CustomerAddressDto"
            }
          ]
        },
        "monthlyBillingEnabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "WITHDRAWN"]
        }
      }
    },
    "CreateMemberDto": {
      "type": "object",
      "properties": {
        "monthlyBillingEnabled": {
          "type": "boolean"
        },
        "groupBillingEnabled": {
          "type": "boolean"
        },
        "departmentSeq": {
          "type": "number",
          "nullable": true,
          "minimum": 1,
          "maximum": 2147483647
        },
        "employeeNo": {
          "type": "string"
        },
        "customerSeq": {
          "type": "number",
          "minimum": 1,
          "maximum": 2147483647
        },
        "role": {
          "type": "string",
          "enum": ["MEMBER", "ORG_ADMIN"]
        }
      },
      "required": ["employeeNo", "customerSeq", "role"]
    },
    "InlineMemberDto": {
      "type": "object",
      "properties": {
        "monthlyBillingEnabled": {
          "type": "boolean"
        },
        "groupBillingEnabled": {
          "type": "boolean"
        },
        "departmentSeq": {
          "type": "number",
          "nullable": true,
          "minimum": 1,
          "maximum": 2147483647
        },
        "employeeNo": {
          "type": "string"
        },
        "address": {
          "nullable": true,
          "type": "object",
          "allOf": [
            {
              "$ref": "#/components/schemas/CustomerAddressDto"
            }
          ]
        },
        "role": {
          "type": "string",
          "enum": ["MEMBER", "ORG_ADMIN"]
        },
        "name": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string",
          "pattern": "^[0-9]{11}(?![\\s\\S])"
        }
      },
      "required": ["employeeNo", "name", "phoneNumber"]
    },
    "CreateMembersDto": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CreateMemberDto"
              },
              {
                "$ref": "#/components/schemas/InlineMemberDto"
              }
            ]
          }
        }
      },
      "required": ["items"]
    },
    "CreateFaqsDto": {
      "type": "object",
      "properties": {
        "items": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CreateFaqDto"
          }
        }
      },
      "required": ["items"]
    },
    "UpdateFaqDto": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "접수",
            "수거 일정",
            "물품·박스",
            "포장·파손",
            "배송·운송장",
            "주소",
            "변경·취소",
            "요금·결제",
            "이용 안내",
            "기타"
          ]
        },
        "question": {
          "type": "string",
          "maxLength": 1000
        },
        "answer": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": ["category", "question", "answer"]
    },
    "OrderCustomerDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string",
          "pattern": "^[0-9]{11}(?![\\s\\S])"
        }
      },
      "required": ["name", "phoneNumber"]
    },
    "ParcelInputDto": {
      "type": "object",
      "properties": {
        "notifiedPrice": {
          "type": "object",
          "minimum": 1,
          "maximum": 2147483647,
          "nullable": true
        },
        "origin": {
          "allOf": [
            {
              "$ref": "#/components/schemas/OrderAddressPatchDto"
            }
          ]
        },
        "destination": {
          "allOf": [
            {
              "$ref": "#/components/schemas/OrderDestinationAddressPatchDto"
            }
          ]
        },
        "originPin": {
          "nullable": true,
          "type": "object",
          "allOf": [
            {
              "$ref": "#/components/schemas/OriginPinDto"
            }
          ]
        },
        "documentCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        },
        "smallBoxCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        },
        "mediumBoxCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        },
        "bigBoxCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        },
        "otherItemDescription": {
          "type": "string"
        },
        "clientComment": {
          "type": "string"
        },
        "itemPrice": {
          "type": "number",
          "nullable": true,
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "ParcelChangeDto": {
      "type": "object",
      "properties": {
        "notifiedPrice": {
          "type": "object",
          "minimum": 1,
          "maximum": 2147483647,
          "nullable": true
        },
        "origin": {
          "allOf": [
            {
              "$ref": "#/components/schemas/OrderAddressPatchDto"
            }
          ]
        },
        "destination": {
          "allOf": [
            {
              "$ref": "#/components/schemas/OrderDestinationAddressPatchDto"
            }
          ]
        },
        "originPin": {
          "nullable": true,
          "type": "object",
          "allOf": [
            {
              "$ref": "#/components/schemas/OriginPinDto"
            }
          ]
        },
        "documentCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        },
        "smallBoxCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        },
        "mediumBoxCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        },
        "bigBoxCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        },
        "otherItemDescription": {
          "type": "string"
        },
        "clientComment": {
          "type": "string"
        },
        "itemPrice": {
          "type": "number",
          "nullable": true,
          "minimum": 1,
          "maximum": 100000000
        },
        "orderParcelSeq": {
          "type": "number",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "CustomerAddressDto": {
      "type": "object",
      "properties": {
        "roadAddress": {
          "type": "string"
        },
        "jibunAddress": {
          "type": "string"
        },
        "detailAddress": {
          "type": "string"
        },
        "dongName": {
          "type": "string"
        },
        "postalCode": {
          "type": "string",
          "pattern": "^[0-9]{5}(?![\\s\\S])"
        }
      },
      "required": ["roadAddress", "jibunAddress", "dongName", "postalCode"]
    },
    "CreateFaqDto": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "접수",
            "수거 일정",
            "물품·박스",
            "포장·파손",
            "배송·운송장",
            "주소",
            "변경·취소",
            "요금·결제",
            "이용 안내",
            "기타"
          ]
        },
        "question": {
          "type": "string",
          "maxLength": 1000
        },
        "answer": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": ["category", "question", "answer"]
    },
    "OrderAddressPatchDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "nullable": true
        },
        "phoneNumber": {
          "type": "string",
          "pattern": "^01[016789][0-9]{8}(?![\\s\\S])",
          "nullable": true
        },
        "roadAddress": {
          "type": "string",
          "nullable": true
        },
        "jibunAddress": {
          "type": "string",
          "nullable": true
        },
        "detailAddress": {
          "type": "string",
          "nullable": true
        },
        "dongName": {
          "type": "string",
          "nullable": true
        },
        "postalCode": {
          "type": "string",
          "nullable": true
        }
      }
    },
    "OrderDestinationAddressPatchDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "nullable": true
        },
        "roadAddress": {
          "type": "string",
          "nullable": true
        },
        "jibunAddress": {
          "type": "string",
          "nullable": true
        },
        "detailAddress": {
          "type": "string",
          "nullable": true
        },
        "dongName": {
          "type": "string",
          "nullable": true
        },
        "postalCode": {
          "type": "string",
          "nullable": true
        },
        "phoneNumber": {
          "type": "string",
          "pattern": "^(?:01[016789][0-9]{8}|02[0-9]{7,8}|0(?:31|32|33|41|42|43|44|51|52|53|54|55|61|62|63|64)[0-9]{7,8}|070[0-9]{8})(?![\\s\\S])",
          "nullable": true
        }
      }
    },
    "OriginPinDto": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["PERSONAL", "COMPANY"]
        },
        "pinSeq": {
          "type": "number",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": ["scope", "pinSeq"]
    }
  }
}
