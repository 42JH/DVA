# npm run dev 때 자동으로 읽는 팀 공통 기본값 (git에 올림 — 비밀 값 넣지 않기)
# 내 컴퓨터에서만 바꿀 값은 .env.development.local 에 (이 파일보다 우선, 커밋 안 됨)
# 주의: .env.local 은 이 파일보다 약해서 여기 있는 값을 못 바꿈 (Vite 규칙) — 실제 백엔드에 붙일 땐 .env.development.local 에 VITE_USE_MOCK=false
VITE_USE_MOCK=true
# 개발 서버 프록시가 /api 요청을 넘길 백엔드 (vite.config.ts). VITE_ 접두사가 없어 브라우저 코드엔 안 들어감
# 다른 서버에 붙을 땐 .env.development.local 에 DEV_PROXY_TARGET=...
DEV_PROXY_TARGET=https://13.209.59.180
