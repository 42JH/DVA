# 쓸 수 있는 변수 목록. 개발 기본값은 .env.development(자동), 내 컴퓨터에서만 바꿀 값은 .env.development.local 에 (커밋하지 않음)
# API 기본 경로 — /api (버전 접두사 없음, 10/26 BE 결정). 개발 서버는 vite.config.ts 프록시가 /api 그대로 DEV_PROXY_TARGET으로 넘김
VITE_API_BASE_URL=/api
# true 면 MSW 가짜 API 사용 (백엔드 없이 화면 개발)
VITE_USE_MOCK=true
# 개발 서버 프록시 대상 (VITE_ 아님 → 브라우저 코드에 안 들어감)
DEV_PROXY_TARGET=https://13.209.59.180

# 시나리오 시험 화면(AI 상담가). 늘 켜짐 — 끌 때만 false (화면과 [통화에 사용하기] 관문이 함께 사라짐)
# VITE_SCENARIO_TEST=false
