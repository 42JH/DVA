[Unit]
Description=Renew Dva IP HTTPS certificate and check remaining lifetime
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
ExecStart=/opt/dva-certbot/bin/certbot renew --quiet --no-random-sleep-on-renew
ExecStartPost=/usr/bin/openssl x509 -in /etc/letsencrypt/live/dva-ip/fullchain.pem -noout -checkend 172800
TimeoutStartSec=300
