{
  "name": "kick-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.mjs\"",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5",
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "express": {
      "body-parser": "2.4.0"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
