[Unit]
Description=디버 리랭커 HTTPS 프록시
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/dvr-reranker/Caddyfile

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
ExecStartPre=-/usr/bin/docker rm -f dvr-reranker-proxy
ExecStart=/usr/bin/docker run --rm --name dvr-reranker-proxy --network host --init --cap-drop=ALL --cap-add=NET_BIND_SERVICE --security-opt=no-new-privileges --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m --volume /etc/dvr-reranker/Caddyfile:/etc/caddy/Caddyfile:ro --volume /opt/dvr-reranker/caddy-data:/data --volume /opt/dvr-reranker/caddy-config:/config caddy:2.10.2-alpine@sha256:d8c17a862962def15cde69863a3a463f25a2664942eafd7bdbf050e9c3116b83
ExecStop=/usr/bin/docker stop --time 20 dvr-reranker-proxy

[Install]
WantedBy=multi-user.target
