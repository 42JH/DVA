# ai/compose.yaml이 읽는 값. 실제 값은 ai/.env에(커밋 금지).
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=

# 고객·주문·배송지를 관리하는 백엔드 서버 API(spec/backend-api.md)
BACKEND_API_URL=
# 카카오 REST API 키: 확정 주소의 지번·동명·우편번호·좌표(접수 필수값). 없으면 접수가 미완료로 넘어간다(spec/address.md)
KAKAO_REST_API_KEY=

# PBX 통화 종료 웹훅 인증 토큰(Authorization: Bearer, PBX 쪽과 같은 값)
PBX_WEBHOOK_SECRET=
# 매뉴얼 RAG용 Qdrant API 키
QDRANT_API_KEY=
# 로컬 CLI에서만 필요. compose는 http://qdrant:6333을 지정한다.
QDRANT_URL=
# RunPod 또는 Google Cloud의 HTTPS 루트 주소(/rerank를 뒤에 붙여 호출).
RAG_RERANKER_URL=
RAG_RERANKER_API_KEY=
MONITOR_USER=
MONITOR_PASSWORD=

# 호스트에서 여는 포트(127.0.0.1만). 기본 8000
AI_PORT=
