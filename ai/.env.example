# 복사해서 .env로 쓴다(.env는 .gitignore 대상). 값은 따옴표 없이.
# 실행: uv run --env-file .env ...

# --- OpenAI (필수) ---
OPENAI_API_KEY=
# 프로젝트 웹훅(live.transport.incoming) 서명 비밀값. whsec_... 형식
OPENAI_WEBHOOK_SECRET=
# PBX SIP 트렁크 대상 sip:<이 값>@sip.api.openai.com;transport=tls (코드는 읽지 않음, PBX 설정용 메모)
OPENAI_PROJECT_ID=

# --- 새 서버(app/main.py) ---
# Responses 위임 Backend 모델 이름(필수, 기본값 없음). 비우면 예전 이름 SPIKE_BACKEND_MODEL을 읽는다
BACKEND_MODEL=
BACKEND_EFFORT=low

# --- S0 스파이크(로컬 실험 전용, 컨테이너 이미지에는 없음) ---
SPIKE_BACKEND_MODEL=
SPIKE_BACKEND_EFFORT=low
# 통화 로그(JSONL) 위치. logs/는 .gitignore 대상. 로그에 통화 전사(개인정보)가 남는다
SPIKE_LOG_DIR=spikes/s0/logs
# 통화 최대 길이(초). 넘으면 서버가 끊는다
SPIKE_MAX_CALL_SEC=300
# 도구 결과를 일부러 늦추는 시간(초). 결과 대기 한계 확인용(0, 5, 12 등으로 바꿔 가며)
SPIKE_TOOL_DELAY_SEC=0
# 발화 중 append 실험(1=켬): 통화 시작 후 이 초가 지난 첫 AI 발화 중에 보낸다
SPIKE_PROBE_COMMENTARY_AT=25
SPIKE_PROBE_THINKING_AT=35
SPIKE_PROBE_INSTRUCTIONS_AT=45
# 켤 실험 이름(쉼표): commentary, thinking, instructions. 1=전부, 0=끔. S0b 기본은 instructions만
# (commentary 실험은 발화를 일으켜 위임 지연 측정을 흐린다). instructions는 AI 발화 도중(3번째 전사 조각)에 보낸다
SPIKE_PROBES=0

# --- S0b ---
# Backend service_tier(비우면 보내지 않음): auto, default, flex, priority, ultrafast, fast_tier_temp_pilot
SPIKE_BACKEND_SERVICE_TIER=priority
# backend = 도구 결과 뒤 Backend가 최종 문장 생성(S0 방식), commentary = 생략하고 서버가 사실을 commentary로 전달
SPIKE_FINAL_MODE=backend

# --- S0d (설계 v3.1) ---
# server = Live 트리거 없이 고객 발화 끝에 서버가 POST /v1/decisions 1번 · trigger = S0 방식(트리거 2개, 발화마다 수십 건)
SPIKE_DECISION_MODE=server
# 발화 끝: 마지막 입력 전사 delta 뒤 이 시간(ms) 동안 새 delta가 없으면(spikes/s0c/RESULTS.md)
SPIKE_UTTERANCE_GAP_MS=800

# --- PBX ---
PBX_WEBHOOK_SECRET=

# --- 관제 화면(/monitor, HTTP Basic). 비어 있으면 503으로 닫힌다. compose에서는 필수 ---
MONITOR_USER=
MONITOR_PASSWORD=
# 끝난 통화를 관제에 남기는 시간(초)
MONITOR_RETAIN_ENDED_SEC=1800

# --- Docker compose ---
# 호스트에 여는 포트(127.0.0.1만). 다른 서비스와 겹치면 바꾼다
AI_PORT=8000
# 행안부 주소DB(address.db) 폴더. 없으면 주소 보정 없이 뜬다
ADDRESS_DATA_DIR=./data
# 미리 빌드한 이미지를 쓸 때만(기본 dva-ai-rebuild:local)
AI_IMAGE=

# --- BE ---
BACKEND_API_URL=
# true면 메모리 가짜 BE(backend_client/mock.py). 운영 배포는 false + BACKEND_API_URL 필수(compose 기본은 true)
BACKEND_MOCK=
# 페르소나 조회·적용 회신과 BE→AI /internal/persona/* 인증(양방향 같은 값, 32자 이상). 비우면 서버 기본 프롬프트
AI_PERSONA_TOKEN=
AI_INSIGHTS_TOKEN=

# --- 주소 ---
KAKAO_REST_API_KEY=

# --- RAG / FAQ 동기화 ---
# 호스트에서 실행할 때 주소(compose 안에서는 http://qdrant:6333로 고정). 대시보드 오버레이를 켜면 http://127.0.0.1:6333
QDRANT_URL=
# Qdrant 서버 API 키이자 클라이언트 키(compose에서 필수). 길고 무작위한 값
QDRANT_API_KEY=
RAG_RERANKER_URL=
RAG_RERANKER_API_KEY=
AI_FAQ_TOKEN=
# RAG 설정·템플릿 위치를 바꿀 때만 CONFIG_DIR=…, PROMPTS_DIR=…를 추가한다(원본과 같음).
# 빈 값으로 두면 원본 코드가 현재 폴더를 설정 위치로 읽으므로 줄 자체를 두지 않는다(기본 config/·prompts/).

# --- 로그 ---
LOG_LEVEL=INFO
