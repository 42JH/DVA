# 복사해서 .env로 쓴다(.env는 .gitignore 대상). 값은 따옴표 없이.
# 실행: uv run --env-file .env ...

# --- OpenAI (필수) ---
OPENAI_API_KEY=
# 프로젝트 웹훅(live.transport.incoming) 서명 비밀값. whsec_... 형식
OPENAI_WEBHOOK_SECRET=
# PBX SIP 트렁크 대상 sip:<이 값>@sip.api.openai.com;transport=tls (코드는 읽지 않음, PBX 설정용 메모)
OPENAI_PROJECT_ID=

# --- 새 서버(app/main.py) ---
# Responses 위임 Backend 모델 이름(비우면 compose 기본 gpt-6-luna. 로컬 uv 실행은 필수)
BACKEND_MODEL=
BACKEND_EFFORT=low

# --- PBX ---
PBX_WEBHOOK_SECRET=

# --- 관제 화면(/monitor, HTTP Basic). 비어 있으면 503으로 닫힌다. compose에서는 필수 ---
MONITOR_USER=
MONITOR_PASSWORD=
# 끝난 통화를 관제에 남기는 시간(초)
MONITOR_RETAIN_ENDED_SEC=1800

# --- Docker compose ---
# 호스트에 여는 포트(127.0.0.1만). 다른 서비스와 겹치면 바꾼다
AI_PORT=8000
# 행안부 주소DB(address.db) 폴더. 없으면 주소 보정 없이 뜬다
ADDRESS_DATA_DIR=./data
# 미리 빌드한 이미지를 쓸 때만(기본 dva-ai-rebuild:local)
AI_IMAGE=

# --- BE ---
BACKEND_API_URL=
# true면 메모리 가짜 BE(backend_client/mock.py). 운영 배포는 false + BACKEND_API_URL 필수(compose 기본은 true)
BACKEND_MOCK=
# 페르소나 조회·적용 회신과 BE→AI /internal/persona/* 인증(양방향 같은 값, 32자 이상). 비우면 서버 기본 프롬프트
AI_PERSONA_TOKEN=
AI_INSIGHTS_TOKEN=

# --- 주소 ---
KAKAO_REST_API_KEY=

# --- RAG / FAQ 동기화 ---
# 호스트에서 실행할 때 주소(compose 안에서는 http://qdrant:6333로 고정). 대시보드 오버레이를 켜면 http://127.0.0.1:6333
QDRANT_URL=
# Qdrant 서버 API 키이자 클라이언트 키(compose에서 필수). 길고 무작위한 값
QDRANT_API_KEY=
RAG_RERANKER_URL=
RAG_RERANKER_API_KEY=
AI_FAQ_TOKEN=
# RAG 설정·템플릿 위치를 바꿀 때만 CONFIG_DIR=…, PROMPTS_DIR=…를 추가한다(원본과 같음).
# 빈 값으로 두면 원본 코드가 현재 폴더를 설정 위치로 읽으므로 줄 자체를 두지 않는다(기본 config/·prompts/).

# --- 로그 ---
LOG_LEVEL=INFO
