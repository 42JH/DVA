# 복사해서 .env로 쓴다(.env는 .gitignore 대상). 값은 따옴표 없이 적는다.
# 로컬 실행: uv run --env-file .env python -m uvicorn app.main:app --port 8000 --workers 1
# compose 실행: docker compose up -d --build (같은 폴더의 .env를 읽는다)

# --- OpenAI ---
# 음성 세션·위임·임베딩에 쓴다. 비우면 서버는 뜨지만 통화 수신이 꺼진다(compose에서는 필수)
OPENAI_API_KEY=
# 수신 전화 웹훅의 서명 비밀값. whsec_... 형식(compose에서는 필수)
OPENAI_WEBHOOK_SECRET=
# Responses 위임 Backend 모델. 로컬 uv 실행은 필수, compose는 비우면 gpt-6-luna
BACKEND_MODEL=
# 위임 Backend 추론 강도
BACKEND_EFFORT=low

# --- PBX ---
# 통화 종료 웹훅 인증(Authorization: Bearer). 비우면 그 웹훅을 503으로 거절한다(compose에서는 필수)
PBX_WEBHOOK_SECRET=

# --- 백엔드(BE) ---
# 실제 BE 주소. BACKEND_MOCK=true가 아니면 필수(compose에서는 항상 필수)
BACKEND_API_URL=
# true면 메모리 가짜 BE(backend_client/mock.py, 재시작하면 사라짐). 비우거나 false면 실제 BE
BACKEND_MOCK=
# 고객·주문·PIN·FAQ 조회 API 서비스 토큰. 배송 초안 연동(config/server.toml)을 켜면 필수
AI_BUSINESS_TOKEN=
# 통화 기록·분석 전송 API 서비스 토큰. 비우면 전송하지 않는다
AI_INSIGHTS_TOKEN=
# 페르소나 조회·적용 회신과 BE→AI /internal/persona/* 인증(양방향 같은 값). 비우면 서버 기본 프롬프트로 응대한다
AI_PERSONA_TOKEN=

# --- 주소 ---
# 카카오 주소 검색(지번·우편번호). 비우면 조회하지 않는다
KAKAO_REST_API_KEY=

# --- RAG / FAQ 동기화 ---
# 로컬 uv 실행에서만 쓴다(compose 안에서는 http://qdrant:6333로 고정). 대시보드 오버레이를 켜면 http://127.0.0.1:6333
QDRANT_URL=
# Qdrant 서버 API 키이자 클라이언트 키. 길고 무작위한 값(compose에서는 필수)
QDRANT_API_KEY=
# 리랭커 서버(gpu/) 주소와 키
RAG_RERANKER_URL=
RAG_RERANKER_API_KEY=
# BE→AI FAQ 변경 알림 인증. 공백 없는 ASCII 32자 이상. FAQ 동기화(config/server.toml [faq_sync])를 켜면 필수
AI_FAQ_TOKEN=

# --- Docker compose 전용 ---
# 호스트에 여는 포트(127.0.0.1만). 다른 서비스와 겹치면 바꾼다
AI_PORT=8000
# 행안부 주소DB(address.db)가 있는 폴더. 없으면 주소 보정 없이 뜬다
ADDRESS_DATA_DIR=./data

# --- 로그 ---
LOG_LEVEL=INFO
